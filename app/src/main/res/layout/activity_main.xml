<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text"
            android:layout_marginTop="8dp" />

        <!-- 大号 LUX 读数 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="22dp"
            android:layout_marginTop="14dp"
            android:gravity="center">

            <TextView
                android:id="@+id/lux"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="60sp"
                android:textStyle="bold"
                android:textColor="@color/accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LUX（照度）"
                android:textSize="13sp"
                android:textColor="@color/muted" />

            <TextView
                android:id="@+id/fc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-- fc"
                android:textSize="15sp"
                android:textColor="@color/accent2"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/ev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EV --"
                android:textSize="15sp"
                android:textColor="@color/text"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- ISO 选择 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="胶卷 ISO（装卷后固定）"
            android:textSize="13sp"
            android:textColor="@color/muted"
            android:layout_marginTop="18dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/isoGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:chipSpacing="8dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/iso100"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100"
                android:checkable="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/iso200"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="200"
                android:checkable="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/iso400"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="400"
                android:checkable="true"
                android:checked="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/iso800"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="800"
                android:checkable="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/iso1600"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1600"
                android:checkable="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/iso3200"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3200"
                android:checkable="true" />
        </com.google.android.material.chip.ChipGroup>

        <!-- 推荐参数表 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="推荐参数（互易律）"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text" />

            <TextView
                android:id="@+id/evIso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@ISO 400  EV --"
                android:textSize="12sp"
                android:textColor="@color/muted"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/rec"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="f/2.8   →  --\nf/4   →  --\nf/5.6   →  --\nf/8   →  --\nf/11   →  --\nf/16   →  --"
                android:textSize="16sp"
                android:textColor="@color/accent2"
                android:fontFamily="monospace"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="6dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="对准光源，读取实时照度"
            android:textSize="12sp"
            android:textColor="@color/muted"
            android:layout_marginTop="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="读数来自环境光传感器（非摄像头），无自动曝光干扰。手机传感器未做 lux 出厂校准，仍有 ±20% 误差，对负片足够。"
            android:textSize="11sp"
            android:textColor="@color/muted2"
            android:layout_marginTop="6dp"
            android:gravity="center" />

        <Button
            android:id="@+id/btnCalc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="互易律计算器 →"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/accent"
            android:textColor="@color/bg" />

    </LinearLayout>
</ScrollView>
