# 复制成 keystore.properties 并填好，然后执行 gradlew assembleRelease。
# 这个文件绝不要提交（.gitignore 已排除）。
#
# 生成密钥库：
#   keytool -genkeypair -v -keystore release.jks -alias lightmeter \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# 注意：密钥库一旦丢失，已上架的应用再也无法更新 —— 必须离线备份。

storeFile=release.jks
storePassword=你的密钥库密码
keyAlias=lightmeter
keyPassword=你的密钥密码
